{
    "devDependencies": {
        "@eslint/js": "^9.37.0",
        "concurrently": "^9.1.2",
        "eslint": "^9.37.0",
        "fs-extra": "^11.3.2",
        "globals": "^16.4.0",
        "htmlhint": "^1.7.1",
        "http-server": "^14.1.1",
        "madge": "^8.0.0",
        "stylelint": "^16.25.0",
        "stylelint-config-recommended": "^17.0.0"
    },
    "scripts": {
        "lint:js": "eslint js",
        "lint:css": "stylelint css",
        "lint:html": "htmlhint **/*.html",
        "dev": "concurrently \"node scripts/build.js --watch\" \"npx http-server -p 8080 -c-1\"",
        "build": "node scripts/build.js",
        "build:public": "npm run build && node -e \"const fs = require('fs-extra'); fs.ensureDir('public').then(() => Promise.all(['assets', 'css', 'dist', 'index.html', 'dashboard.html'].map((f) => fs.copy(f, 'public/' + f)))).then(() => console.log('✅ Successfully!'));\""
    },
    "dependencies": {
        "esbuild": "^0.25.10"
    }
}